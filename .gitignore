# Research directory (raw/intermediate data stays local)
research/*
!research/sources.md

# Node (puppeteer used for screenshots only, not part of project)
node_modules/
package.json
package-lock.json

# Local environment (proxy URL etc.)
.env

# Playwright test output artifacts (regenerated)
test-results/
playwright-report/

# Claude Code commands (local skills, not shared)
.claude/

# Vendored CDN libs for offline mode (fetched on demand via scripts/setup-offline.mjs)
docs/vendor/

# Local working plan (Claude Code session plans, user-readable)
PLAN.md

# Session scratch: eval-run output dirs, helper scripts, screenshots (regenerated)
tmp/

# Session resume/handoff prompt (regenerated per handoff)
RESUME_PROMPT.md

# Session handovers and implementation-brief plans (per-session scratch; the
# shipped work lives in git history, so these don't belong in version control)
HANDOVER_*.md
NEXT-SESSION-PROMPT.md
*_PLAN.md
eval/
