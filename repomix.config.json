{
  "output": {
    "style": "xml",
    "filePath": "bundle.xml"
  },
  "include": [
    "README.md",
    "CONSULT.md",
    "CLAUDE.md",
    "AGENTS.md",
    "foundations/**/*.md",
    "color/**/*.md",
    "typography/**/*.md",
    "layout/**/*.md",
    "interaction/**/*.md",
    "responsive/**/*.md",
    "systems/**/*.md",
    "expressive/**/*.md",
    "heuristics/**/*.md",
    "components/**/*.md",
    "workflows/**/*.md",
    "docs/llms.txt",
    "docs/presets/_index.md",
    "docs/presets/FRAMEWORKS.md",
    "docs/presets/index.json"
  ],
  "ignore": {
    "customPatterns": [
      "bundle.xml",
      "repomix.config.json"
    ]
  }
}
