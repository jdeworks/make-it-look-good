  color: {
    primary: '#2563eb',
    primaryHover: '#1d4ed8',
    text: '#0f172a',
    textSecondary: '#475569',
    border: '#e2e8f0',
    surface: '#f8fafc',
    success: '#16a34a',
    successBg: '#f0fdf4',
    error: '#dc2626',
  },
  space: { 1: 4, 2: 8, 3: 12, 4: 16, 5: 20, 6: 24, 8: 32 },
  radius: { sm: 4, md: 8, lg: 12 },
  fontSize: { sm: 14, base: 16, lg: 18, xl: 20, '2xl': 24 },
  minTarget: 44,
};
```

