<file path="docs/tests/edge-layout.html">
<!-- Edge Case: Layout, Spacing, Touch, Typography -->
<!-- Tests: spacing grid, overflow, negative margins, touch targets, line length, fixed widths, truncation -->
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
body{font-family:system-ui;margin:0;padding:24px}
.section{margin-bottom:24px;padding:16px;border:1px solid #e5e7eb;border-radius:8px}
h2{font-size:16px;margin-bottom:8px}
</style>
</head><body>
<header><nav><a href="#">Home</a></nav></header>
<main>

<section class="section">
  <h1>Edge Case: Layout & Spacing</h1>
</section>

<section class="section">
  <h2>1. Off-grid spacing (5px, 7px, 13px, 22px)</h2>
  <div style="padding: 5px;">5px padding (not on 4px grid)</div>
  <div style="margin-top: 7px;">7px margin</div>
  <div style="padding: 13px;">13px padding</div>
  <div style="margin-top: 22px;">22px margin</div>
</section>

<section class="section">
  <h2>2. Element overflow</h2>
  <div style="width: 200px; overflow: hidden; border: 1px solid #ccc;">
    <div style="width: 400px; background: #fee2e2; padding: 8px;">This div overflows its container — 400px inside 200px</div>
  </div>
</section>

<section class="section">
  <h2>3. Negative margins</h2>
  <div style="margin-top: -12px; background: #fef3c7; padding: 8px;">margin-top: -12px</div>
  <div style="margin-left: -8px; background: #dbeafe; padding: 8px;">margin-left: -8px</div>
