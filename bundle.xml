          groupId[startIdx] = gid;
          while (stack.length > 0) {
            var ci = stack.pop();
            groupPixels[gid].push(ci);
            var cx = ci % cw, cy = (ci - cx) / cw;
            for (var dy = -1; dy <= 1; dy++) {
              var ny = cy + dy;
              if (ny < 0 || ny >= ch) continue;
              for (var dx = -1; dx <= 1; dx++) {
                if (dx === 0 && dy === 0) continue;
                var nx = cx + dx;
                if (nx < 0 || nx >= cw) continue;
                var ni = ny * cw + nx;
                if (groupId[ni] === 0 && zone[ni] === zoneVal) {
                  groupId[ni] = gid;
                  stack.push(ni);
                }
              }
            }
          }
          return gid;
        }

        for (var i = 0; i < cw * ch; i++) {
          if (groupId[i] === 0 && (zone[i] === 2 || zone[i] === 3)) {
            floodFill(i, zone[i]);
          }
        }
        var totalGroups = nextGroup - 1;
        console.log('[test-page] ' + totalGroups + ' groups found');

        // Step 7: Compute group centroids and average colors from ORIGINAL screenshot
        var origPx = origCtx.getImageData(0, 0, Math.min(cw, origCanvas.width), Math.min(ch, origCanvas.height)).data;
        var origW = Math.min(cw, origCanvas.width);

        var groupCx = new Float32Array(nextGroup);
        var groupCy = new Float32Array(nextGroup);
        var groupR = new Float32Array(nextGroup);
        var groupG = new Float32Array(nextGroup);
        var groupB = new Float32Array(nextGroup);

        for (var gid = 1; gid < nextGroup; gid++) {
          var pxls = groupPixels[gid];
          var sumX = 0, sumY = 0, sumR = 0, sumG = 0, sumB = 0;
          for (var p = 0; p < pxls.length; p++) {
            var idx = pxls[p];
            var px = idx % cw, py = (idx - px) / cw;
            sumX += px; sumY += py;
            if (px < origW && py * origW + px < origPx.length / 4) {
              var oi = (py * origW + px) * 4;
              sumR += origPx[oi]; sumG += origPx[oi+1]; sumB += origPx[oi+2];
            }
          }
          var n = pxls.length || 1;
          groupCx[gid] = sumX / n;
          groupCy[gid] = sumY / n;
          groupR[gid] = Math.round(sumR / n);
          groupG[gid] = Math.round(sumG / n);
          groupB[gid] = Math.round(sumB / n);
        }

        // Step 8: Match each FG group to nearest BG group
        var fgToBg = {}; // fgGid -> bgGid
        for (var gid = 1; gid < nextGroup; gid++) {
          if (groupZone[gid] !== 2) continue; // skip non-FG
          var bestDist = Infinity, bestBg = -1;
          for (var bgid = 1; bgid < nextGroup; bgid++) {
            if (groupZone[bgid] !== 3) continue;
            var ddx = groupCx[gid] - groupCx[bgid];
            var ddy = groupCy[gid] - groupCy[bgid];
            var d2 = ddx * ddx + ddy * ddy;
            if (d2 < bestDist) { bestDist = d2; bestBg = bgid; }
          }
          if (bestBg > 0) fgToBg[gid] = bestBg;
        }

        // Step 9: Calculate contrast ratios
        function luminance(r, g, b) {
          var rs = r/255, gs = g/255, bs = b/255;
          var rl = rs <= 0.03928 ? rs/12.92 : Math.pow((rs+0.055)/1.055, 2.4);
          var gl = gs <= 0.03928 ? gs/12.92 : Math.pow((gs+0.055)/1.055, 2.4);
          var bl = bs <= 0.03928 ? bs/12.92 : Math.pow((bs+0.055)/1.055, 2.4);
          return 0.2126*rl + 0.7152*gl + 0.0722*bl;
        }
        function contrastRatio(r1,g1,b1, r2,g2,b2) {
          var l1 = luminance(r1,g1,b1), l2 = luminance(r2,g2,b2);
          return Math.round(((Math.max(l1,l2)+0.05) / (Math.min(l1,l2)+0.05)) * 100) / 100;
        }

        var groupContrast = {}; // fgGid -> ratio
        for (var fgid in fgToBg) {
          var bgid = fgToBg[fgid];
          groupContrast[fgid] = contrastRatio(
            groupR[fgid], groupG[fgid], groupB[fgid],
            groupR[bgid], groupG[bgid], groupB[bgid]
          );
        }

        // Step 10: Render edge overlay
        var oc = document.createElement('canvas');
        oc.width = cw; oc.height = ch;
        var ox = oc.getContext('2d');
        var imgd = ox.createImageData(cw, ch);
        var d = imgd.data;
        var edgeCount = 0, fgCount = 0, bgCount = 0;
        for (var i = 0; i < cw * ch; i++) {
          var pi = i * 4;
          if (zone[i] === 1) {
            d[pi]=255; d[pi+1]=30; d[pi+2]=30; d[pi+3]=230; edgeCount++;
          } else if (zone[i] === 2) {
            d[pi]=255; d[pi+1]=160; d[pi+2]=0; d[pi+3]=180; fgCount++;
          } else if (zone[i] === 3) {
            d[pi]=30; d[pi+1]=200; d[pi+2]=80; d[pi+3]=140; bgCount++;
          }
        }
        ox.putImageData(imgd, 0, 0);

        var overlay = document.createElement('div');
        overlay.className = '__milg-diag';
        overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:99998;overflow:hidden;';
        var innerDiv = document.createElement('div');
        innerDiv.style.cssText = 'position:absolute;top:0;left:0;width:100%;transform:translateY(-' + window.scrollY + 'px);';
        var edgeImg = document.createElement('img');
        edgeImg.src = oc.toDataURL();
        edgeImg.style.cssText = 'width:' + (cw / SCALE) + 'px;height:' + (ch / SCALE) + 'px;opacity:0.85;image-rendering:pixelated;pointer-events:none;';
        innerDiv.appendChild(edgeImg);
        overlay.appendChild(innerDiv);

        // Tooltip for hover
        var tooltip = document.createElement('div');
        tooltip.className = '__milg-status';
        tooltip.style.cssText = 'position:fixed;z-index:100002;background:rgba(0,0,0,0.92);color:#fff;' +
          'padding:8px 12px;border-radius:6px;font:11px/1.6 monospace;pointer-events:none;display:none;' +
          'border:1px solid rgba(255,255,255,0.2);max-width:280px;';
        overlay.appendChild(tooltip);

        // Legend
        var legend = document.createElement('div');
        legend.className = '__milg-status';
        legend.style.cssText = 'position:fixed;bottom:40px;right:12px;z-index:100001;' +
          'background:rgba(0,0,0,0.9);color:#fff;padding:8px 12px;border-radius:6px;' +
          'font:11px/1.6 monospace;pointer-events:none;border:1px solid rgba(255,255,255,0.15);';
        legend.innerHTML = '<span style="color:#ff1e1e">\u2588</span> edge (' + edgeCount + ')  ' +
          '<span style="color:#ffa000">\u2588</span> FG 0.5-1.5px (' + fgCount + ')  ' +
          '<span style="color:#1ec850">\u2588</span> BG 3-4px (' + bgCount + ')  ' +
          '@' + SCALE + 'x  |  hover for contrast';
        overlay.appendChild(legend);

        // Hover interaction
        var _lastGid = -1;
        overlay.style.pointerEvents = 'auto';
        overlay.addEventListener('mousemove', function(e) {
          var rect = edgeImg.getBoundingClientRect();
          var mx = Math.round((e.clientX - rect.left) * SCALE);
          var my = Math.round((e.clientY - rect.top + window.scrollY) * SCALE);
          if (mx < 0 || mx >= cw || my < 0 || my >= ch) { tooltip.style.display = 'none'; _lastGid = -1; return; }
          var idx = my * cw + mx;
          var gid = groupId[idx];

          // If hovering bg, also look for bg group
          if (!gid && zone[idx] === 0) {
            // Search small radius for nearest group
            for (var r = 1; r <= 8 && !gid; r++) {
              for (var sdy = -r; sdy <= r && !gid; sdy++) {
                for (var sdx = -r; sdx <= r && !gid; sdx++) {
                  var si = (my+sdy)*cw + (mx+sdx);
                  if (si >= 0 && si < cw*ch && groupId[si]) gid = groupId[si];
                }
              }
            }
          }

          if (!gid || gid === _lastGid) { if (!gid) { tooltip.style.display = 'none'; _lastGid = -1; } return; }
          _lastGid = gid;

          var fgGid, bgGid;
          if (groupZone[gid] === 2) {
            fgGid = gid;
            bgGid = fgToBg[gid] || -1;
          } else if (groupZone[gid] === 3) {
            bgGid = gid;
            // Find the FG group matched to this BG
            fgGid = -1;
            for (var fk in fgToBg) { if (fgToBg[fk] === gid) { fgGid = parseInt(fk); break; } }
          } else {
            tooltip.style.display = 'none'; return;
          }

          if (fgGid < 1 || bgGid < 1) { tooltip.style.display = 'none'; return; }

          var ratio = groupContrast[fgGid] || contrastRatio(
            groupR[fgGid],groupG[fgGid],groupB[fgGid],
            groupR[bgGid],groupG[bgGid],groupB[bgGid]
          );
          var fgCol = 'rgb('+groupR[fgGid]+','+groupG[fgGid]+','+groupB[fgGid]+')';
          var bgCol = 'rgb('+groupR[bgGid]+','+groupG[bgGid]+','+groupB[bgGid]+')';
          var pass = ratio >= 4.5 ? 'PASS' : ratio >= 3 ? 'AA-lg' : 'FAIL';
          var passCol = ratio >= 4.5 ? '#4ade80' : ratio >= 3 ? '#fbbf24' : '#ef4444';

          tooltip.innerHTML =
            '<div style="margin-bottom:4px"><span style="color:'+passCol+';font-weight:700">' + ratio + ':1 ' + pass + '</span></div>' +
            '<div style="display:flex;align-items:center;gap:6px;margin:3px 0">' +
              '<span style="display:inline-block;width:16px;height:16px;border-radius:3px;border:1px solid rgba(255,255,255,0.3);background:'+fgCol+'"></span>' +
              '<span>FG ' + fgCol + ' (' + (groupPixels[fgGid]||[]).length + 'px)</span></div>' +
            '<div style="display:flex;align-items:center;gap:6px;margin:3px 0">' +
              '<span style="display:inline-block;width:16px;height:16px;border-radius:3px;border:1px solid rgba(255,255,255,0.3);background:'+bgCol+'"></span>' +
              '<span>BG ' + bgCol + ' (' + (groupPixels[bgGid]||[]).length + 'px)</span></div>';
          tooltip.style.display = 'block';
          tooltip.style.left = Math.min(e.clientX + 12, window.innerWidth - 290) + 'px';
          tooltip.style.top = (e.clientY + 16) + 'px';
        });

        overlay.addEventListener('mouseleave', function() {
          tooltip.style.display = 'none'; _lastGid = -1;
        });

        document.body.appendChild(overlay);
        _overlays.push(overlay);
        overlay._inner = innerDiv;

        console.log('[test-page] Edges: ' + edgeCount + ' edge, ' + fgCount + ' FG, ' + bgCount + ' BG, ' + totalGroups + ' groups');
        if (_statusEl) _statusEl.textContent = 'overlay: edges + contrast  [right-click]';

      }).catch(function(e) {
        tmpStyle.remove();
        console.warn('[test-page] Mask capture failed:', e);
        if (_statusEl) _statusEl.textContent = 'edges: mask capture failed';
      });
    }).catch(function(e) {
      console.warn('[test-page] Original capture failed:', e);
      if (_statusEl) _statusEl.textContent = 'edges: original capture failed';
    });
  }

  function updateStatus() {
    if (!_statusEl) {
      _statusEl = document.createElement('div');
      _statusEl.className = '__milg-status';
      _statusEl.style.cssText = 'position:fixed;bottom:12px;right:12px;z-index:100001;' +
        'background:rgba(0,0,0,0.9);color:#fff;padding:8px 14px;border-radius:6px;' +
        'font:12px/1.4 monospace;pointer-events:none;border:1px solid rgba(255,255,255,0.15);';
      document.body.appendChild(_statusEl);
    }
    var labels = { normal: 'normal', bbox: 'bbox (blue)', mask: 'mask (b/w)', edges: 'edges (red/blue)' };
    _statusEl.textContent = 'overlay: ' + labels[_mode] + '  [right-click]';
    _statusEl.style.opacity = _mode === 'normal' ? '0' : '1';
    if (_mode === 'normal') {
      setTimeout(function() { if (_mode === 'normal' && _statusEl) _statusEl.style.opacity = '0'; }, 2000);
    } else {
      _statusEl.style.opacity = '1';
    }
  }

  document.addEventListener('contextmenu', function(e) {
    e.preventDefault();
    var idx = _modes.indexOf(_mode);
    _mode = _modes[(idx + 1) % _modes.length];
    if (_mode === 'normal') { clearOverlays(); removeMask(); }
    else if (_mode === 'bbox') { removeMask(); showBboxes(); }
    else if (_mode === 'mask') { clearOverlays(); showMask(); }
    else if (_mode === 'edges') { clearOverlays(); removeMask(); showEdges(); }
    updateStatus();
  });

  // Recalc bbox overlays on scroll
  var _scrollTimer;
  window.addEventListener('scroll', function() {
    clearTimeout(_scrollTimer);
    _scrollTimer = setTimeout(function() {
      if (_mode === 'bbox') showBboxes();
      else if (_mode === 'mask' && _maskOverlay) {
        var inner = _maskOverlay.firstElementChild;
        if (inner) inner.style.transform = 'translateY(-' + window.scrollY + 'px)';
      } else if (_mode === 'edges') {
        _overlays.forEach(function(o) {
          if (o._inner) o._inner.style.transform = 'translateY(-' + window.scrollY + 'px)';
        });
      }
    }, 16);
  }, { passive: true });

  console.log('[test-page] Mask diagnostic overlay ready. Right-click to cycle: normal → bbox → mask');
})();
</script>
