<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mask Alignment Test</title>
<style>
  body { margin: 0; padding: 20px; padding-top: 80px; font-family: system-ui, -apple-system, sans-serif; background: #f5f5f5; }
  .test-row { margin: 12px 0; padding: 8px 12px; background: white; border-radius: 4px; }

  /* Fixed header — tests mask alignment for position:fixed elements */
  .fixed-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: #1e293b; padding: 0 20px; height: 56px;
    display: flex; align-items: center; gap: 24px;
  }
  .fixed-header .logo { font-size: 18px; font-weight: 700; color: white; }
  .fixed-header .nav-link { font-size: 14px; color: #94a3b8; text-decoration: none; }
  .fixed-header .nav-link:hover { color: white; }
  .fixed-header .cta { font-size: 13px; font-weight: 600; color: white; background: #3b82f6; padding: 6px 16px; border-radius: 6px; margin-left: auto; }

  /* Sticky section header */
  .sticky-header {
    position: sticky; top: 56px; z-index: 50;
    background: #e2e8f0; padding: 8px 12px; font-size: 12px; font-weight: 600; color: #475569;
    border-bottom: 1px solid #cbd5e1;
  }
  .dark-row { background: #1a1a2e; }
  .gradient-row { background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); }

  /* Size variants */
  .sz-10 { font-size: 10px; color: #333; }
  .sz-12 { font-size: 12px; color: #333; }
  .sz-14 { font-size: 14px; color: #333; }
  .sz-16 { font-size: 16px; color: #333; }
  .sz-20 { font-size: 20px; color: #333; }
  .sz-24 { font-size: 24px; color: #333; }
  .sz-32 { font-size: 32px; color: #333; }
  .sz-48 { font-size: 48px; color: #333; }

  /* Weight variants */
  .w-300 { font-weight: 300; }
  .w-400 { font-weight: 400; }
  .w-600 { font-weight: 600; }
  .w-700 { font-weight: 700; }
  .w-900 { font-weight: 900; }

  /* Style variants */
  .italic { font-style: italic; }
  .ls-tight { letter-spacing: -0.5px; }
  .ls-wide { letter-spacing: 2px; }
  .lh-tight { line-height: 1.0; }
  .lh-loose { line-height: 2.0; }

  /* Light on dark */
  .light-text { color: #e0e0e0; }
  .light-text-low { color: #888; }

  /* Serif / mono */
  .serif { font-family: Georgia, 'Times New Roman', serif; }
  .mono { font-family: 'Courier New', monospace; }

  /* Transform */
  .uppercase { text-transform: uppercase; }
  .shadow { text-shadow: 1px 1px 2px rgba(0,0,0,0.3); }
  .outline { -webkit-text-stroke: 1px #333; color: transparent; }

  .label { display: inline-block; min-width: 180px; font-size: 11px; color: #999; vertical-align: middle; }
</style>
</head><body>

