  }

  console.log('\n\x1b[1mResults: ' + passed + ' passed, ' + failed + ' failed, ' + skipped + ' skipped\x1b[0m');

  await browser.close();
  server.close();
  process.exit(failed > 0 ? 1 : 0);
}

run().catch(function(e) { console.error(e); process.exit(1); });
